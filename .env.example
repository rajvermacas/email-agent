# Info-Agent Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================

# Provider selection: openai, azure_openai, gemini, openrouter
# This MUST be set - no fallback/default
LLM_PROVIDER=

# Model name (varies by provider)
# OpenAI: gpt-4-turbo, gpt-4o, gpt-4o-mini
# Azure: Your deployment name
# Gemini: gemini-pro, gemini-1.5-pro, gemini-1.5-flash
# OpenRouter: provider/model (e.g., anthropic/claude-3-opus)
LLM_MODEL=

# -----------------------------------------------------------------------------
# OpenAI Configuration (if LLM_PROVIDER=openai)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Azure OpenAI Configuration (if LLM_PROVIDER=azure_openai)
# -----------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-01

# -----------------------------------------------------------------------------
# Google Gemini Configuration (if LLM_PROVIDER=gemini)
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# OpenRouter Configuration (if LLM_PROVIDER=openrouter)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# FastAPI Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Mail Agent (A2A Worker)
MAIL_AGENT_HOST=0.0.0.0
MAIL_AGENT_PORT=8002

# Validation Agent (A2A Worker)
VALIDATION_AGENT_HOST=0.0.0.0
VALIDATION_AGENT_PORT=8003

# Mock Email Server
EMAIL_SERVER_HOST=0.0.0.0
EMAIL_SERVER_PORT=8080
SMTP_PORT=1025

# A2A Registry (embedded in Gateway)
A2A_REGISTRY_URL=http://localhost:8000/api/registry

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP settings for mock email server
SMTP_HOST=localhost

# Webhook URL for email notifications (called when new email arrives)
EMAIL_WEBHOOK_URL=http://localhost:8000/webhooks/email

# =============================================================================
# DATABASE PATHS
# =============================================================================

# SQLite database files (relative to project root)
CHECKPOINT_DB_PATH=data/checkpoints.db
EMAIL_DB_PATH=data/emails.db
REGISTRY_DB_PATH=data/registry.db

# =============================================================================
# TIMEOUT CONFIGURATION
# =============================================================================

# Default timeout for waiting for email response (in hours)
# Set to small values for demo (e.g., 0.083 = 5 minutes)
DEFAULT_TIMEOUT_HOURS=48

# Number of retries before escalating
DEFAULT_RETRY_COUNT=3

# Python execution timeout for validation agent (in seconds)
VALIDATION_TIMEOUT_SECONDS=30

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, console
LOG_FORMAT=json

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:8080

# Debug mode (set to false in production)
DEBUG=true
