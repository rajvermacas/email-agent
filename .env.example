# ===================
# Info-Agent Phase 1 MVP Backend Configuration
# ===================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control

# ===================
# LLM Configuration
# ===================
# Google Gemini API Key (required)
GOOGLE_API_KEY=your-google-api-key-here

# LLM Model Settings
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ===================
# Server Configuration
# ===================
# Host to bind servers to
HOST=0.0.0.0

# FastAPI Gateway port
GATEWAY_PORT=8000

# Mail Agent A2A server port
MAIL_AGENT_PORT=8001

# Mock Email Server REST API port
EMAIL_SERVER_PORT=8025

# Mock Email Server SMTP port
SMTP_PORT=1025

# Debug mode (true/false)
DEBUG=true

# ===================
# A2A Registry Configuration
# ===================
# URL of the A2A Registry (embedded in gateway)
A2A_REGISTRY_URL=http://localhost:8000/a2a

# ===================
# Mock Email Server Configuration
# ===================
# SMTP host for Mail Agent to connect to
SMTP_HOST=localhost

# Webhook URL for email notifications (gateway endpoint)
EMAIL_WEBHOOK_URL=http://localhost:8000/webhooks/email

# ===================
# Database Paths
# ===================
# SQLite database for LangGraph checkpoints
CHECKPOINT_DB_PATH=data/checkpoints.db

# SQLite database for mock email storage
EMAIL_DB_PATH=data/emails.db

# SQLite database for A2A registry
REGISTRY_DB_PATH=data/registry.db

# SQLite database for workflow storage
WORKFLOW_DB_PATH=data/workflows.db

# ===================
# Logging Configuration
# ===================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or console
LOG_FORMAT=console

# ===================
# Workflow Configuration
# ===================
# Default timeout for waiting for email responses (hours)
DEFAULT_TIMEOUT_HOURS=48

# Default number of retry attempts
DEFAULT_RETRY_COUNT=3
